#  Using PANDAS

--pd.Series() → converts your data (string/list/tuple) into a pandas Series.

.value_counts() → counts unique values and sorts them by frequency.---

----------------------------------------------------------------String------------------------------------------------------------------
import pandas as pd   # ✅ Always import pandas first

a = "Hello world"    
series = pd.Series(list(a))   # ✅ Convert string → list of characters → Series

print(series.value_counts())  # ✅ Call the method with parentheses
